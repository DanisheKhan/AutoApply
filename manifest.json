{
  "manifest_version": 3,
  "name": "AutoApply Pro - Universal Job Form Filler",
  "version": "1.0.0",
  "description": "Autofill job applications across Google Forms, TCS, Infosys, LinkedIn, Naukri, Greenhouse, Lever, and AI firms powered by Gemini AI.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AutoApply Pro",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "trigger_visual_snip": {
      "suggested_key": {
        "default": "Alt+X"
      },
      "description": "Visual AI Snip & Autofill"
    },
    "trigger_autofill": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "1-Click Form Autofill"
    },
    "trigger_snip": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Snip & Fill Area"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "assets/resume-data.js",
        "default-profile.js",
        "content/heuristics.js",
        "content/resume-uploader.js",
        "content/adapters.js",
        "content/field-popup.js",
        "content/snip-selector.js",
        "content/visual-snip.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png",
        "content/*.css",
        "assets/*",
        "DanishKhan_Resume.pdf"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
